# Optional API ORIGIN, without /api or a trailing slash.
# Local development defaults to the Vite /api proxy on port 5000.
# Vercel: set this to your deployed API URL, then redeploy the frontend.
VITE_API_BASE_URL=

# Optional browser API key. Restrict it to Maps Embed API and your website domains.
VITE_GOOGLE_MAPS_API_KEY=
