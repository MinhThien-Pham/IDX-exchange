NODE_ENV=development
PORT=5000
# Copy the pooled Neon connection string here; never commit .env.
DATABASE_URL=postgresql://user:password@localhost:5432/idx_exchange
# Optional direct Neon URL for migrations; falls back to DATABASE_URL.
# DATABASE_MIGRATION_URL=postgresql://user:password@host/idx_exchange?sslmode=require
# Exact browser origins, separated by commas; no paths or trailing slashes.
FRONTEND_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# Optional private source database used only by the MLS importer.
# MLS_MYSQL_URL=mysql://user:password@localhost:3306/idx_exchange
# MLS_SOURCE=crmls
# MLS_TIME_ZONE=America/Los_Angeles
